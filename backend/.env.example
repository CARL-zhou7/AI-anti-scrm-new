# Local development only. Copy to backend/.env and replace the three DB values.
# Use the actual MySQL schema name in DB_URL, not the IDEA connection label.
# This file uses Java properties syntax: no surrounding quotes or "export".
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/anti_scam?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Optional real LLM in dev; otherwise the scripted model is used.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_deepseek_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Optional local CosyVoice gateway; start it before enabling these values.
# TTS_PROVIDER=cosyvoice
# TTS_GATEWAY_URL=http://127.0.0.1:50080
# Local RTX 4060 test: a 120-character line took about 40 seconds.
# app.simulation.tts.call-timeout-ms=60000
