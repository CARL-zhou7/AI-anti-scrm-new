# Local development only. Copy to backend/.env and replace the three DB values.
# Use the actual MySQL schema name in DB_URL, not the IDEA connection label.
# This file uses Java properties syntax: no surrounding quotes or "export".
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/anti_scam?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Optional real LLM in dev; otherwise the scripted model is used.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_deepseek_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Optional Qwen speech. Configure a Beijing workspace and audition-confirmed voice IDs first.
# TTS_PROVIDER=qwen
# QWEN_API_KEY=your_beijing_api_key
# QWEN_TTS_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
# QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# QWEN_TTS_REGION=beijing
# All 18 defaults are confirmed in application.yml; optional per-slot overrides:
# QWEN_VOICE_YOUTH_MALE_PRIMARY=longanyang_v3.1
# QWEN_VOICE_YOUTH_MALE_BACKUP=longanlang_v3.1
# QWEN_VOICE_YOUTH_FEMALE_PRIMARY=anruorou_v3.1
# QWEN_VOICE_YOUTH_FEMALE_BACKUP=longyingtao_v3.1
# QWEN_VOICE_YOUTH_NEUTRAL_PRIMARY=longanyang_v3.1
# QWEN_VOICE_YOUTH_NEUTRAL_BACKUP=longanlang_v3.1
# QWEN_VOICE_MIDDLE_MALE_PRIMARY=longanlang_v3.1
# QWEN_VOICE_MIDDLE_MALE_BACKUP=longzhe_v3.1
# QWEN_VOICE_MIDDLE_FEMALE_PRIMARY=longyingtao_v3.1
# QWEN_VOICE_MIDDLE_FEMALE_BACKUP=anruorou_v3.1
# QWEN_VOICE_MIDDLE_NEUTRAL_PRIMARY=longanlang_v3.1
# QWEN_VOICE_MIDDLE_NEUTRAL_BACKUP=longzhe_v3.1
# QWEN_VOICE_SENIOR_MALE_PRIMARY=libai_v3.1
# QWEN_VOICE_SENIOR_MALE_BACKUP=longzhe_v3.1
# QWEN_VOICE_SENIOR_FEMALE_PRIMARY=longyingtao_v3.1
# QWEN_VOICE_SENIOR_FEMALE_BACKUP=anruorou_v3.1
# QWEN_VOICE_SENIOR_NEUTRAL_PRIMARY=libai_v3.1
# QWEN_VOICE_SENIOR_NEUTRAL_BACKUP=longzhe_v3.1
